{
  "name": "voz-gg-agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/voz-gg-agent",
  "tags": ["type:service", "lang:go"],
  "release": {
    "version": {
      "versionActions": "tools/release/go-version-actions.cjs"
    }
  },
  "targets": {
    "build": {
      "command": "go build -ldflags \"-X main.version=$(cat VERSION)\" -o dist/voz-gg-agent .",
      "options": { "cwd": "services/voz-gg-agent" },
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": { "executor": "@nx-go/nx-go:serve" },
    "test": { "executor": "@nx-go/nx-go:test" },
    "lint": { "executor": "@nx-go/nx-go:lint" }
  }
}
