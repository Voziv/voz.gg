{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": ["type:app", "lang:ts"],
  "targets": {
    "dev": { "command": "astro dev", "options": { "cwd": "apps/web" } },
    "build": {
      "command": "astro build",
      "options": { "cwd": "apps/web" },
      "outputs": ["{projectRoot}/dist"]
    },
    "preview": {
      "command": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
      "options": { "cwd": "apps/web" },
      "dependsOn": ["build"]
    },
    "deploy": {
      "command": "wrangler deploy --config dist/server/wrangler.json",
      "options": { "cwd": "apps/web" },
      "dependsOn": ["build"]
    },
    "db:generate": {
      "command": "drizzle-kit generate",
      "options": { "cwd": "apps/web" }
    },
    "types": {
      "command": "wrangler types",
      "options": { "cwd": "apps/web" }
    },
    "migrate": {
      "command": "wrangler d1 migrations apply voz-gg --remote",
      "options": { "cwd": "apps/web" }
    },
    "migrate:local": {
      "command": "wrangler d1 migrations apply voz-gg --local",
      "options": { "cwd": "apps/web" }
    },
    "test": {
      "command": "vitest run --passWithNoTests",
      "options": { "cwd": "apps/web" }
    }
  }
}
