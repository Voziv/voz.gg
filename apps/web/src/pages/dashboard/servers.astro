---
export const prerender = false;
import { env } from 'cloudflare:workers';
import { eq, desc } from 'drizzle-orm';
import { createDb, servers, serverStatus, serverUpdateState, serverSnapshot, serverUpdateEvent, type GameType } from '@voz/shared';
import { displayStatus } from '../../lib/status-display';
import { toServerFormData } from '../../lib/server-form-data';
import { isAdmin } from '../../lib/admin';
import Dashboard from '../../layouts/Dashboard.astro';
import { Card, CardContent } from '../../components/ui/card.tsx';
import StatusBadge from '../../components/dashboard/StatusBadge.tsx';
import UpdateBadge from '../../components/dashboard/UpdateBadge.tsx';
import UpdateActions from '../../components/dashboard/UpdateActions.tsx';
import ServerFormDialog from '../../components/dashboard/ServerFormDialog.tsx';
import DeleteServerButton from '../../components/dashboard/DeleteServerButton.tsx';
import AgentInstallDialog from '../../components/dashboard/AgentInstallDialog.tsx';

const POLL_INTERVAL_SECONDS = 30;
const db = createDb(env.DB);
const rows = await db
  .select({ server: servers, status: serverStatus, updateState: serverUpdateState })
  .from(servers)
  .leftJoin(serverStatus, eq(serverStatus.serverId, servers.id))
  .leftJoin(serverUpdateState, eq(serverUpdateState.serverId, servers.id))
  .all();
const admin = isAdmin(Astro.locals.user);
const now = new Date();

// Snapshot inventory + recent audit events power the per-server update controls
// (admin only). Loaded once and grouped by server id.
const snapshotsByServer = new Map<string, { snapshotId: string; version: string | null; createdAt: string }[]>();
const eventsByServer = new Map<string, { at: string; kind: string; fromVersion: string | null; toVersion: string | null; status: string; error: string | null }[]>();
if (admin) {
  for (const s of await db.select().from(serverSnapshot).orderBy(desc(serverSnapshot.createdAt)).all()) {
    const list = snapshotsByServer.get(s.serverId) ?? [];
    list.push({ snapshotId: s.snapshotId, version: s.version, createdAt: (s.createdAt as Date).toISOString() });
    snapshotsByServer.set(s.serverId, list);
  }
  for (const e of await db.select().from(serverUpdateEvent).orderBy(desc(serverUpdateEvent.at)).limit(50).all()) {
    const list = eventsByServer.get(e.serverId) ?? [];
    if (list.length < 10) {
      list.push({ at: (e.at as Date).toISOString(), kind: e.kind, fromVersion: e.fromVersion, toVersion: e.toVersion, status: e.status, error: e.error });
      eventsByServer.set(e.serverId, list);
    }
  }
}

const GAME_LABELS: Record<GameType, string> = {
  'minecraft-java': 'Minecraft (Java)',
  'minecraft-bedrock': 'Minecraft (Bedrock)',
  source: 'Source',
  'generic-tcp': 'TCP',
  unknown: 'Unknown',
};
---
<Dashboard>
  <div class="mx-auto max-w-5xl">
    <div class="mb-8 flex items-end justify-between">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">Servers</h1>
        <p class="mt-1 text-muted-foreground">Connection details for community game servers.</p>
      </div>
      {admin && <ServerFormDialog client:load />}
    </div>

    {rows.length === 0 ? (
      <Card className="border-border bg-card">
        <CardContent className="py-12 text-center text-muted-foreground">
          No servers configured yet.{admin ? ' Click "Add server" to create one.' : ''}
        </CardContent>
      </Card>
    ) : (
      <div class="overflow-hidden rounded-lg border border-border bg-card">
        <table class="w-full text-sm">
          <thead class="bg-muted text-left text-xs uppercase tracking-wide text-muted-foreground">
            <tr>
              <th class="px-4 py-3 font-medium">Name</th>
              <th class="px-4 py-3 font-medium">Game</th>
              <th class="px-4 py-3 font-medium">Address</th>
              <th class="px-4 py-3 font-medium">Status</th>
              {admin && <th class="px-4 py-3 font-medium" aria-label="Actions" />}
            </tr>
          </thead>
          <tbody>
            {rows.map(({ server: s, status, updateState }) => {
              const display = displayStatus(status, POLL_INTERVAL_SECONDS, now);
              return (
              <tr class="border-t border-border">
                <td class="px-4 py-3">
                  <div class="font-medium text-foreground">{s.name}</div>
                  {s.description && <div class="text-xs text-muted-foreground">{s.description}</div>}
                </td>
                <td class="px-4 py-3 text-muted-foreground">{GAME_LABELS[s.gameType] ?? s.gameType}</td>
                <td class="px-4 py-3 font-mono text-muted-foreground">{s.host}:{s.port}</td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap gap-1">
                    <StatusBadge status={display.status} players={display.players} maxPlayers={display.maxPlayers} />
                    <UpdateBadge updateSource={s.updateSource ?? null} currentVersion={s.currentVersion ?? null} availableVersion={updateState?.availableVersion ?? null} lastError={updateState?.lastError ?? null} applyStatus={updateState?.applyStatus ?? null} />
                  </div>
                </td>
                {admin && (
                  <td class="px-4 py-3">
                    <div class="flex flex-col items-end gap-2">
                      <div class="flex justify-end gap-1">
                        <AgentInstallDialog client:load serverId={s.id} serverName={s.name} />
                        <ServerFormDialog
                          client:load
                          server={toServerFormData(s)}
                        />
                        <DeleteServerButton client:load id={s.id} name={s.name} />
                      </div>
                      <UpdateActions
                        client:load
                        serverId={s.id}
                        policy={s.updatePolicy ?? 'notify'}
                        majorPolicy={s.majorUpdatePolicy ?? (s.updateSource === 'vanilla' ? 'auto' : 'approve')}
                        currentVersion={s.currentVersion ?? null}
                        availableVersion={updateState?.availableVersion ?? null}
                        availableMajorVersion={updateState?.availableMajorVersion ?? null}
                        serverControlEnabled={s.serverControlEnabled ?? false}
                        applyStatus={updateState?.applyStatus ?? null}
                        snapshots={snapshotsByServer.get(s.id) ?? []}
                        events={eventsByServer.get(s.id) ?? []}
                      />
                    </div>
                  </td>
                )}
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</Dashboard>
