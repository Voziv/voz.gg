---
export const prerender = true;

import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.tsx';

const dots = Array.from({ length: 40 }, (_, i) => ({
  cx: (i % 5) * 20 + 10,
  cy: Math.floor(i / 5) * 20 + 10,
  delay: i * 80,
}));

const racks = [0, 1, 2];
---

<Base>
  <main class="min-h-screen flex flex-col md:flex-row bg-background text-foreground">
    <div class="fixed right-4 top-4 z-50">
      <ThemeToggle client:load />
    </div>
    <div class="flex-1 flex flex-col items-center justify-center gap-6 p-12">
      <h1 class="text-8xl font-bold tracking-tight">voz.gg</h1>
      <p class="text-lg text-muted-foreground">
        Game servers hosted by Voz for 1LD, WTK, & friends.
      </p>
      <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
        <a href="/request-invite" class="rounded bg-primary text-primary-foreground hover:bg-primary/80 px-6 py-2 font-semibold transition-colors">Request an invite</a>
        <a href="/sign-in" class="rounded border border-primary text-primary hover:bg-primary/10 px-6 py-2 font-semibold transition-colors">Sign In</a>
      </div>
    </div>
    <div
      class="hidden md:flex flex-1 items-center justify-center bg-card border-l border-border"
    >
      <svg width="220" height="260" viewBox="0 0 220 260" fill="none" aria-hidden="true">
        {
          dots.map((dot) => (
            <circle
              cx={dot.cx}
              cy={dot.cy}
              r="3"
              fill="var(--primary)"
              style={`animation: dot-pulse 2s ease-in-out infinite; animation-delay: ${dot.delay}ms;`}
            />
          ))
        }
        {
          racks.map((rackIndex) => (
            <g transform={`translate(0, ${178 + rackIndex * 26})`}>
              <rect
                x="10"
                y="0"
                width="160"
                height="18"
                rx="3"
                fill="var(--muted)"
                stroke="var(--border)"
                stroke-width="1"
              />
              <circle
                cx="182"
                cy="9"
                r="4"
                fill="var(--success)"
                style={`animation: dot-pulse 3s ease-in-out infinite; animation-delay: ${rackIndex * 600}ms;`}
              />
            </g>
          ))
        }
      </svg>
    </div>
  </main>
</Base>

<style is:global>
  @keyframes dot-pulse {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 1;
    }
  }
</style>
